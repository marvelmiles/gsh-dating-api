# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Port the HTTP server binds to. Defaults to 10000 when omitted.
PORT=10000

# Set to "production" on a deployed environment. Anything else is treated as
# development and switches the API to the development databases.
NODE_ENV=development

# Legacy alias for NODE_ENV. Either variable flips the API into production mode.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
# The API resolves a connection string from the request origin. Origins that
# belong to Breezeup use the primary pair, every other origin (Soulmater) uses
# the *_TEST_* pair. Production mode picks the PROD variables.
MONGODB_PROD_URI=mongodb+srv://user:password@cluster.mongodb.net/breezeup
MONGODB_PROD_TEST_URI=mongodb+srv://user:password@cluster.mongodb.net/soulmater
MONGODB_DEV_URI=mongodb://127.0.0.1:27017/breezeup-dev
MONGODB_DEV_TEST_URI=mongodb://127.0.0.1:27017/soulmater-dev

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Secret used to sign the access and refresh JSON Web Tokens.
JWT_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Transactional mail (Nodemailer over Gmail)
# ---------------------------------------------------------------------------
# Gmail app password for the Breezeup sender account.
MAIL_PASSWORD=your-gmail-app-password

# Gmail app password for the Soulmater sender account.
MAIL_PASSWORD_OTHER=your-secondary-gmail-app-password

# ---------------------------------------------------------------------------
# Firebase storage (media uploads)
# ---------------------------------------------------------------------------
FIREBASE_PRIVATE_KEY_ID=your-firebase-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-here\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Seeding (scripts/seed.js)
# ---------------------------------------------------------------------------
# Password assigned to every credential based test account created by the seed
# script. Must satisfy the password policy: 8+ characters with an uppercase,
# lowercase, number and symbol.
SEED_TEST_ACCOUNT_PASSWORD=TestUser@123
